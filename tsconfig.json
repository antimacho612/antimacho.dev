{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [ "src/*" ]
    }
  },
  "include": [ ".astro/types.d.ts", "src/**/*", "astro.config.mjs" ],
  "exclude": [ "dist", "node_modules" ]
}
