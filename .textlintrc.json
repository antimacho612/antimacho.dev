{
  "plugins": {
    "@textlint/markdown": {
      "extensions": [".md", ".mdx"]
    }
  },
  "filters": {},
  "rules": {
    "prh": {
      "rulePaths": ["./prh/index.yml"]
    },
    "ja-no-redundant-expression": true,
    "ja-unnatural-alphabet": true,
    "no-doubled-joshi": true,
    "preset-ja-spacing": {
      "ja-space-around-code": {
        "before": false,
        "after": false
      },
      "ja-no-space-around-parentheses": false
    }
  }
}
