{
  "name": "antimacho.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:markdown": "markdownlint-cli2 \"src/content/posts/**/*.mdx\"",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,astro,css,json}": [
      "prettier --write"
    ],
    "src/content/posts/**/*.mdx": [
      "node scripts/updateFrontmatter",
      "markdownlint-cli2"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/simple-icons": "^1.2.93",
    "astro": "7.2.2",
    "astro-icon": "^1.1.5",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cookie": "2.0.1",
    "cspell": "^10.0.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.0.7",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.2.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2"
  }
}
