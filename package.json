{
  "name": "antimacho.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "vitepress:dev": "vitepress dev",
    "vitepress:build": "vitepress build",
    "lint:eslint": "eslint \".vitepress/theme/**/*.{ts,mts,vue}\" --fix",
    "lint:markdown": "markdownlint-cli2 \"posts/**/*.md\"",
    "lint:text": "textlint \"posts/**/*.md\"",
    "prettier": "prettier . --check --write",
    "prepare": "husky"
  },
  "lint-staged": {
    ".vitepress/theme/**/*.{ts,mts,vue}": [
      "prettier",
      "eslint"
    ],
    "posts/**/*.md": [
      "node scripts/updateFrontmatter",
      "textlint",
      "markdownlint-cli2"
    ]
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.0",
    "@types/node": "^20.11.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "cookie": "2.0.1",
    "cspell": "^9.4.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.33.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.0.7",
    "lint-staged": "^15.2.0",
    "markdown-it": "^14.0.0",
    "markdownlint-cli2": "^0.19.1",
    "mermaid": "^11.12.2",
    "prettier": "^3.2.4",
    "sass": "^1.70.0",
    "textlint": "^15.4.1",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-preset-ja-spacing": "^2.3.0",
    "textlint-rule-prh": "^6.1.0",
    "vitepress": "^1.0.0-rc.42",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.4.15"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vueuse/core": "^10.7.2",
    "astro": "7.2.2",
    "primevue": "^3.48.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3"
  }
