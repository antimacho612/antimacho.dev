{
  "name": "antimacho.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:markdown": "markdownlint-cli2 \"src/content/posts/**/*.mdx\"",
    "lint:text": "textlint \"src/content/posts/**/*.mdx\"",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,astro,css,json}": [
      "prettier --write"
    ],
    "src/content/posts/**/*.mdx": [
      "node scripts/updateFrontmatter",
      "textlint",
      "markdownlint-cli2"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.2",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^20.11.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cookie": "2.0.1",
    "cspell": "^9.4.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.0.7",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.19.1",
    "prettier": "^3.2.4",
    "prettier-plugin-astro": "0.14.1",
    "textlint": "^15.4.1",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-preset-ja-spacing": "^2.3.0",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "6.0.3"
  }
}
