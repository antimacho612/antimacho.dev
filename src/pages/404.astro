---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="ページが見つかりません">
  <div class="not-found">
    <p class="code">404</p>
    <h1 class="title">ページが見つかりません</h1>
    <a class="home-link" href={withBase('/')}>ホームに戻る</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .code {
    font-size: 3rem;
    font-weight: 700;
    color: var(--primary-color);
  }

  .title {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .home-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--primary-color);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
