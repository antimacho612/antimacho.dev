---
import ChevronDoubleUpIcon from '../icons/ChevronDoubleUpIcon.astro';
---

<button type="button" class="back-to-top" title="ページ先頭に戻る" data-back-to-top>
  <ChevronDoubleUpIcon class="icon" />
  <span class="visually-hidden">ページ先頭に戻る</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--surface-border);
    border-radius: 50%;
    color: var(--text-color-secondary);
    background-color: var(--surface-card);
    box-shadow: var(--shadow-2);
    opacity: 0;
    visibility: hidden;
    z-index: var(--z-index-back-to-top);
    transition:
      opacity var(--transition-duration),
      visibility var(--transition-duration),
      color var(--transition-duration),
      border-color var(--transition-duration);
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    color: var(--primary-color);
    border-color: var(--primary-color);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (button) {
    const update = () => button.classList.toggle('is-visible', window.scrollY > 300);
    update();
    window.addEventListener('scroll', update, { passive: true });
    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
