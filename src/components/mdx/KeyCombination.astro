---
import Key from './Key.astro';

/**
 * 同時押しのキー。キーの間に + が入る。
 *
 * ```mdx
 * <KeyCombination values={['Ctrl', 'Shift', 'P']} />
 * ```
 */
interface Props {
  values: string[];
}

const { values } = Astro.props;
---

<span class="key-combination">
  {
    values.map((value, index) => (
      <>
        {index > 0 && <span class="plus">+</span>}
        <Key value={value} />
      </>
    ))
  }
</span>

<style>
  .key-combination {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .plus {
    font-size: 0.8125rem;
    color: var(--text-color-secondary);
  }
</style>
