---
/**
 * Mermaid 図を埋め込む。
 *
 * ```mdx
 * <Mermaid
 *   title="リクエストの流れ"
 *   chart={`sequenceDiagram
 *     Browser->>Server: GET /posts
 *     Server-->>Browser: 200 OK`}
 * />
 * ```
 */
interface Props {
  chart: string;
  /** 図のキャプション */
  title?: string;
}

const { chart, title } = Astro.props;
---

<figure class="mermaid-figure" data-mermaid>
  <template set:text={chart} />
  <div class="target" data-mermaid-target></div>
  {title && <figcaption class="caption">{title}</figcaption>}
</figure>

<style>
  .mermaid-figure {
    margin-block: 1.5rem;
    border: 1px solid var(--surface-border);
    border-radius: 0.75rem;
    background-color: var(--surface-card);
    overflow: hidden;
  }

  .target {
    display: flex;
    justify-content: center;
    padding: 1.25rem;
    overflow-x: auto;
  }

  .target :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .caption {
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--surface-border);
    font-size: 0.8125rem;
    color: var(--text-color-secondary);
    background-color: var(--surface-50);
  }
</style>

<script>
  import { setupMermaid } from '../../lib/mermaid';

  void setupMermaid();
</script>
